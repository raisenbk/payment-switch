# Copy to .env to override the local defaults used by docker-compose.yml and the `local` profile.
# These are throwaway development values; never put real credentials in this file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=paymentswitch
DB_USER=paymentswitch
DB_PASSWORD=change-me

# Base64-encoded 32-byte AES key that encrypts merchant secrets at rest.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

REDIS_PORT=6379
APP_PORT=8080
